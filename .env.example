# AxisAgentic provider configuration.
# Copy to .envs/.env and fill in values for the machine where you run jobs.
#
# Runtime settings such as dataset paths, output dirs, concurrency, token
# limits, timeouts, judge settings, and tool limits belong in YAML configs.
# Provider default model names may live here and be overridden by YAML.

# --- Main OpenAI-compatible model provider ---
OPENAI_MODEL=your-model-name
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key

# --- Web search provider ---
SERPER_API_KEY=your-serper-api-key
SERPER_BASE_URL=https://google.serper.dev

# --- Web scrape provider ---
JINA_API_KEY=your-jina-api-key
JINA_BASE_URL=https://r.jina.ai

# --- Python sandbox provider ---
E2B_API_KEY=your-e2b-api-key

# --- Summary LLM provider ---
SUMMARY_LLM_MODEL_NAME=summary-model-name
SUMMARY_LLM_BASE_URL=http://localhost:8000/v1/chat/completions
SUMMARY_LLM_API_KEY=your-summary-llm-api-key

# --- Context-compression LLM provider (optional) ---
COMPRESSION_LLM_MODEL_NAME=compression-model-name
COMPRESSION_LLM_BASE_URL=http://localhost:8000/v1/chat/completions
COMPRESSION_LLM_API_KEY=your-compression-llm-api-key

# --- Evaluation judge provider (optional; defaults to the main provider) ---
JUDGE_MODEL=judge-model-name
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_API_KEY=your-judge-api-key
